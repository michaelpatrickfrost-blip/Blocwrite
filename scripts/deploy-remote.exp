#!/usr/bin/expect -f
# Usage: DEPLOY_PASS="yourpass" ./scripts/deploy-remote.exp [command]
# Or: ./scripts/deploy-remote.exp "ls -la"
set timeout 60
set host "217.154.51.15"
set user "root"
if {[info exists env(DEPLOY_PASS)]} {
    set pass $env(DEPLOY_PASS)
} else {
    set pass ""
}
if {[catch {set f [open [file join [file dirname [info script]] .deploy-pass] r]; set pass [string trim [read -nonewline $f]]; close $f} err]} {
    # .deploy-pass not found, pass stays empty or from env
}
if {$pass == ""} {
    puts "Error: set DEPLOY_PASS or create scripts/.deploy-pass with server password"
    exit 1
}

set cmd [lindex $argv 0]
if {$cmd == ""} { set cmd "hostname" }

spawn ssh -o StrictHostKeyChecking=no ${user}@${host} $cmd

expect {
    "password:" {
        send "$pass\r"
        exp_continue
    }
    "Password:" {
        send "$pass\r"
        exp_continue
    }
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    eof { exit 0 }
    timeout { puts "Timeout"; exit 1 }
}
